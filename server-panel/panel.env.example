# Copy to panel.env and set a unique administrator password before starting.
PANEL_USERNAME=admin
PANEL_PASSWORD=

# Optional: use a long random value and keep it private. If unset, the panel stores
# a generated key in the persistent config directory.
PANEL_SECRET=

# Only enable when a trusted reverse proxy overwrites forwarding headers.
PANEL_TRUST_PROXY=0

# Optional task rehearsal. When enabled, a manual/scheduled run records the
# accounts it would process but never starts a browser or sends a message.
# Keep this disabled for normal operation.
PANEL_DRY_RUN=0

# Optional durable run store.  0 keeps the JSON files as the primary store;
# 1 imports send-status.json/run-events.jsonl once and mirrors future writes
# to SQLite at logs/run-store.sqlite3.
PANEL_RUN_STORE_SQLITE=0

# Optional periodic login health check for all accounts.  0 disables it;
# 21600 checks every six hours.  A check is skipped while sending or authorizing.
PANEL_HEALTH_CHECK_INTERVAL=0

# Legacy browser push is disabled by default; email is the supported result
# notification channel.  Set to 1 only when deliberately keeping Web Push.
PANEL_WEBPUSH_ENABLED=0

# Optional per-user email notifications. Leave SMTP_HOST empty to disable.
# SMTP credentials belong here on the server; never commit the configured file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_FROM can be omitted when it is the same as SMTP_USERNAME.
SMTP_FROM=
SMTP_FROM_NAME=DouYinSparkFlow
# For port 587 use STARTTLS; for port 465 set SMTP_USE_SSL=1 and SMTP_STARTTLS=0.
SMTP_USE_SSL=0
SMTP_STARTTLS=1
